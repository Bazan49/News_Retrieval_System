# Ejemplo de archivo de configuración de entorno.
# Copia este archivo como `.env` y rellena los valores según tu entorno.

# ============================================
# VARIABLES OBLIGATORIAS (debes rellenar)
# ============================================

# Contraseña del usuario 'elastic' de Elasticsearch
ELASTICSEARCH_PASSWORD=TU_PASSWORD_AQUI

# Clave de API de Mistral (para el módulo RAG)
MISTRAL_API_KEY="TU_MISTRAL_API_KEY"

# Clave secreta para firmar tokens JWT (genera una larga y aleatoria)
SECRET_KEY=una_clave_secreta_muy_larga_y_aleatoria

# ============================================
# VARIABLES OPCIONALES (tienen valores por defecto)
# ============================================

# ============================================
# Elasticsearch (Indexación y búsqueda dispersa)
# ============================================
# En desarrollo local (sin Docker): usa https://localhost:9200
# En Docker Compose: se sobreescribe con ELASTICSEARCH_HOSTS=["https://elasticsearch:9200"] dentro del servicio.
ELASTICSEARCH_HOSTS=["https://localhost:9200"]
ELASTICSEARCH_USERNAME=elastic
INDEX_NAME=news_chunks

# Puerto del host para Elasticsearch (solo para Docker). Por defecto 9200.
ELASTICSEARCH_PORT_HOST=9200

# ============================================
# ChromaDB (Almacenamiento vectorial)
# ============================================
# En desarrollo local: CHROMA_HOST=localhost, CHROMA_PORT=8001.
# En Docker Compose: se sobreescribe con CHROMA_HOST=chroma, CHROMA_PORT=8000 dentro del servicio.
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=news_embeddings

# Puerto del host para ChromaDB (solo para Docker). Por defecto 8001.
CHROMA_PORT_HOST=8001

# ============================================
# Aplicación FastAPI (backend)
# ============================================
# Puerto del host para la API (solo para Docker). Por defecto 8000.
APP_PORT_HOST=8000

# ============================================
# Módulo: Embeddings (Modelos de representación)
# ============================================
# Modelo de sentence-transformers (ej. para español: jinaai/jina-embeddings-v2-base-es)
EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-es
# Longitud máxima de contexto del modelo (en tokens)
MODEL_MAX_SEQ_LEN=8192
# Backend opcional (onnx / None). Jina soporta ONNX oficialmente.
EMBEDDING_BACKEND=onnx

# ============================================
# Módulo: Chunking (Segmentación de documentos)
# ============================================
# Tamaño máximo de cada chunk en tokens (debe ser <= MODEL_MAX_SEQ_LEN - 2)
CHUNKER_MAX_TOKENS=512
# Solapamiento entre chunks. Se expresa como porcentaje del tamaño del chunk (ej: 15% de 512 = 77 tokens de solapamiento).
OVERLAP_PERCENT=15

# ============================================
# Módulo: RAG (Generación aumentada por recuperación)
# ============================================
# Configuración para el generador Mistral
MODEL_ID=mistral-small-latest
TEMPERATURE=0.3
MAX_TOKENS=500
FREQUENCY_PENALTY=0.5
PRESENCE_PENALTY=0.3
TOP_P=0.95

# Configuración del ContextBuilder (selección de fragmentos para RAG)
RAG_MAX_CHUNKS=10
RAG_MAX_CHUNKS_PER_DOC=2

# ============================================
# Módulo: Refinamiento de consultas (Feedback)
# ============================================
REFINEMENT_TOP_N=5

# ============================================
# Módulo: Web Search (Búsqueda externa)
# ============================================
GOOGLE_NEWS_LANG=es-419
GOOGLE_NEWS_COUNTRY=US

# ============================================
# Módulo: Autenticación JWT
# ============================================
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# Módulo: Ranking y Posicionamiento (Re‑ranking, scoring y combinación lineal)
# ============================================
# Parámetros de fusión RRF
RRF_K=60

# Pesos de la fórmula de posicionamiento (deben sumar 1)
W_RELEVANCE=0.6
W_PERSONALIZATION=0.2
W_RECENCY=0.2

# Frescura: decaimiento exponencial (días para que el factor baje)
RECENCY_DECAY_DAYS=30

# Modelo Cross-Encoder para re‑ranking opcional
CROSS_ENCODER_MODEL_NAME_OR_PATH=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# Si se debe usar el cross-encoder como fuente de relevancia en el posicionamiento (True/False)
ACTIVATE_CROSS_ENCODER_FOR_RELEVANCE=True